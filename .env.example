# --- Devin ---
# Service user API key (starts with cog_) and org id (GET https://api.devin.ai/v3/self)
DEVIN_API_KEY=
DEVIN_ORG_ID=
# true = simulated Devin: no API calls, no spend. Set to false for real runs.
DEVIN_MOCK=true
# Hard budget per session, enforced by Devin
DEVIN_MAX_ACU_LIMIT=20
# Only used for cost reporting on the dashboard
DEVIN_ACU_PRICE_USD=2.25

# --- GitHub ---
# Your Superset fork, e.g. your-user/superset
GITHUB_REPO=
# Required for real runs: fine-grained token for the fork only,
# with Issues: Read and write, and Pull requests: Read.
GITHUB_TOKEN=
TRIGGER_LABEL=devin:remediate

# --- Orchestration ---
# How often to check GitHub for newly labeled issues and Devin for session progress
POLL_INTERVAL_S=30
MAX_NUDGES=1
MAX_ATTEMPTS=3
SESSION_TIMEOUT_MIN=90
HOURS_SAVED_PER_FIX=2

# Optional: only needed if you expose POST /webhooks/github to GitHub for instant pickup
GITHUB_WEBHOOK_SECRET=

DB_PATH=data/remediation.db
